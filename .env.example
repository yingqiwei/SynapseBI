# ============================================================
# SynapseBI 环境变量示例（复制为 .env 后按需修改）
# ============================================================

# 向量数据库（Qdrant）
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 大模型（Ollama / OpenAI 兼容接口）
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_API_BASE=http://localhost:11434/v1

# 结构化数据库
DB_PATH=./data/enterprise.db

# API 服务
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
